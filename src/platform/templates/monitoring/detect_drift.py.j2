"""Data/prediction drift detection for {{ project_name }} (PSI per feature)."""
import argparse
import json
from pathlib import Path

import numpy as np
import pandas as pd

PSI_ALERT_THRESHOLD = 0.2


def psi(expected: pd.Series, actual: pd.Series, bins: int = 10) -> float:
    """Population Stability Index between two numeric distributions."""
    quantiles = np.unique(np.quantile(expected.dropna(), np.linspace(0, 1, bins + 1)))
    if len(quantiles) < 3:
        return 0.0
    e_counts, _ = np.histogram(expected.dropna(), bins=quantiles)
    a_counts, _ = np.histogram(actual.dropna(), bins=quantiles)
    e_pct = np.clip(e_counts / max(e_counts.sum(), 1), 1e-6, None)
    a_pct = np.clip(a_counts / max(a_counts.sum(), 1), 1e-6, None)
    return float(np.sum((a_pct - e_pct) * np.log(a_pct / e_pct)))


def detect(baseline_path: str, current_path: str, output_path: str) -> dict:
    baseline = pd.read_csv(baseline_path)
    current = pd.read_csv(current_path)
    report = {"features": {}, "alerts": []}
    for column in baseline.select_dtypes(include=[np.number]).columns:
        if column not in current.columns:
            continue
        value = psi(baseline[column], current[column])
        report["features"][column] = round(value, 4)
        if value > PSI_ALERT_THRESHOLD:
            report["alerts"].append({"feature": column, "psi": round(value, 4)})
    report["drift_detected"] = bool(report["alerts"])
    Path(output_path).parent.mkdir(parents=True, exist_ok=True)
    Path(output_path).write_text(json.dumps(report, indent=2))
    return report


if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("--baseline-data", required=True)
    parser.add_argument("--current-data", required=True)
    parser.add_argument("--output", default="drift_report.json")
    args = parser.parse_args()
    result = detect(args.baseline_data, args.current_data, args.output)
    print(json.dumps(result, indent=2))
