# --- LLM (GitHub Models) ---
GITHUB_TOKEN=ghp_your_github_pat        # GitHub.com PAT with Models access
GITHUB_MODEL=gpt-4o                     # gpt-4o | gpt-4.1 | o3 (as available)

# --- Source control ---
REPO_PAT=your_azure_devops_pat          # PAT for cloning/pushing the target repo
AZDO_PAT=                               # optional separate AzDO PAT (defaults to REPO_PAT)
AZDO_ORG_URL=https://dev.azure.com/yourorg
AZDO_PROJECT=your_project

# --- Azure ---
AZURE_SUBSCRIPTION_ID=
AML_RESOURCE_GROUP=              # e.g. my-mlops-rg
AML_WORKSPACE=                   # e.g. my-aml-workspace
AML_COMPUTE_TARGET=              # e.g. gpu-cluster (must exist in the workspace)
ACR_NAME=                        # e.g. myacr  (without .azurecr.io suffix)

# --- Observability (Arize Phoenix) ---
PHOENIX_ENABLED=true
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006   # local `phoenix serve` or Phoenix Cloud endpoint
PHOENIX_PROJECT_NAME=repo-remediation-agent

# --- Runtime ---
MAX_RETRIES=3
MAX_REFLECTION_ROUNDS=2
REMEDIATION_BRANCH=remediation/agent
LOG_LEVEL=INFO
