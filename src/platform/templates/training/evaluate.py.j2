"""Evaluate {{ model_name }} on held-out data, with a registration gate."""
import argparse
import json
import sys
from pathlib import Path

import mlflow
import pandas as pd
from sklearn import metrics as skm

# Minimum primary metric required to register the model — tunable per project
# (edit in chat: "set register_threshold to 0.85"). 0 means always register.
REGISTER_THRESHOLD = {{ register_threshold }}
{% if project_type in ("binary_classification", "multiclass_classification") -%}
PRIMARY_METRIC = "accuracy"
{%- else -%}
PRIMARY_METRIC = "r2"
{%- endif %}


def evaluate(model_dir: str, data_path: str, output_path: str) -> dict:
    model = mlflow.sklearn.load_model(model_dir)
    df = pd.read_csv(data_path)
    target = "{{ target_variable or 'target' }}"
    X, y = df.drop(columns=[target]), df[target]
    predictions = model.predict(X)

    results = {}
    {% if project_type in ("binary_classification", "multiclass_classification") -%}
    results["accuracy"] = float(skm.accuracy_score(y, predictions))
    results["f1"] = float(skm.f1_score(y, predictions, average="weighted"))
    {%- else -%}
    results["rmse"] = float(skm.mean_squared_error(y, predictions) ** 0.5)
    results["r2"] = float(skm.r2_score(y, predictions))
    {%- endif %}

    # Log to the AML run's MLflow tracker (URI is pre-wired in every AML job) so the
    # metrics appear in Studio and feed champion/challenger comparison — not just a file.
    for name, value in results.items():
        mlflow.log_metric(name, value)

    Path(output_path).parent.mkdir(parents=True, exist_ok=True)
    Path(output_path).write_text(json.dumps(results, indent=2))
    return results


if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("--model-dir", required=True)
    parser.add_argument("--data-path", required=True)
    parser.add_argument("--output", default="outputs/metrics.json")
    parser.add_argument("--register-threshold", type=float, default=REGISTER_THRESHOLD)
    args = parser.parse_args()
    results = evaluate(args.model_dir, args.data_path, args.output)
    print(results)

    # Registration gate: fail the step (and thus block model registration) when the
    # primary metric is below the threshold. threshold = 0 always passes.
    primary = results.get(PRIMARY_METRIC, 0.0)
    if args.register_threshold and primary < args.register_threshold:
        print(f"❌ {PRIMARY_METRIC}={primary:.4f} < register threshold {args.register_threshold} — blocking registration")
        sys.exit(1)
    print(f"✓ {PRIMARY_METRIC}={primary:.4f} ≥ register threshold {args.register_threshold} — eligible to register")
