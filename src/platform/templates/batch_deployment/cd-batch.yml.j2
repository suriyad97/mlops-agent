# CD: deploy the batch endpoint (approval-gated for prod)
trigger: none
pool: { vmImage: ubuntu-latest }

# Per-environment Azure targets (dev/qa/prod RG + workspace + service connection)
variables:
  - template: variables.yml

stages:
  - stage: DeployDev
    jobs:
      - job: dev
        steps:
          - task: AzureCLI@2
            displayName: Create/update batch endpoint (dev)
            inputs:
              azureSubscription: $(SERVICE_CONNECTION_DEV)
              scriptType: bash
              scriptLocation: inlineScript
              inlineScript: |
                set -e
                az ml batch-endpoint create --file MLpipelines/batch_endpoint.yml \
                  --resource-group $(RESOURCE_GROUP_DEV) --workspace-name $(WORKSPACE_DEV) || true
                az ml batch-deployment create --file MLpipelines/batch_deployment.yml \
                  --resource-group $(RESOURCE_GROUP_DEV) --workspace-name $(WORKSPACE_DEV)

  - stage: DeployProd
    dependsOn: DeployDev
    jobs:
      - deployment: prod
        environment: {{ safe_name }}-prod    # approval-gated
        strategy:
          runOnce:
            deploy:
              steps:
                - checkout: self
                - task: AzureCLI@2
                  displayName: Create/update batch endpoint (prod)
                  inputs:
                    azureSubscription: $(SERVICE_CONNECTION_PROD)
                    scriptType: bash
                    scriptLocation: inlineScript
                    inlineScript: |
                      set -e
                      az ml batch-endpoint create --file MLpipelines/batch_endpoint.yml \
                        --resource-group $(RESOURCE_GROUP_PROD) --workspace-name $(WORKSPACE_PROD) || true
                      az ml batch-deployment create --file MLpipelines/batch_deployment.yml \
                        --resource-group $(RESOURCE_GROUP_PROD) --workspace-name $(WORKSPACE_PROD)
